pkgname=nyrasview
pkgver=2.1.0
pkgrel=1
pkgdesc="Control center for AI-driven development: see, steer and coordinate your AI coding agents"
arch=('any')
url="https://github.com/nyrasdev/nyrasview"
license=('MIT')
depends=('python' 'python-psutil')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('git: checkpoints, review and the watch view'
            'cloudflared: reach nyrasview from your phone anywhere')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('1f4148d41cf6c34869b6dc24e0029bdc2ca47fc914f81b810006b507ba9abb8f')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
  PYTHONPATH="$PWD" python -m nyrasview completion fish > nyrasview.fish
  PYTHONPATH="$PWD" python -m nyrasview completion bash > nyrasview.bash
}

check() {
  cd "$pkgname-$pkgver"
  PYTHONPATH="$PWD" python -m nyrasview --version | grep -q "$pkgver"
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 nyrasview.fish "$pkgdir/usr/share/fish/vendor_completions.d/nyrasview.fish"
  install -Dm644 nyrasview.bash "$pkgdir/usr/share/bash-completion/completions/nyrasview"
}
